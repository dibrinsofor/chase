## SQLite Build - Hardcoded Chasefile for benchmarking
## Builds from amalgamation: sqlite3.c -> sqlite3 CLI + libsqlite3

set shell = ["sh", "-c"]
set CC = "cc"
set CFLAGS = "-O2 -DSQLITE_THREADSAFE=1 -DSQLITE_ENABLE_FTS5 -DSQLITE_ENABLE_JSON1 -DSQLITE_ENABLE_RTREE"

build:
    summary: "Build SQLite"
    uses: [sqlite3, libsqlite3]
    cmds: "echo 'SQLite build complete'"

sqlite3:
    summary: "Build sqlite3 CLI"
    uses: amalgamation
    inputs: ["sqlite3.c", "shell.c", "sqlite3.h"]
    outputs: ["sqlite3"]
    cmds: "$CC $CFLAGS -o sqlite3 shell.c sqlite3.c -lpthread -ldl -lm"

libsqlite3:
    summary: "Build libsqlite3 static library"
    uses: amalgamation
    inputs: ["sqlite3.c", "sqlite3.h"]
    outputs: ["libsqlite3.a"]
    cmds: [
        "$CC $CFLAGS -c sqlite3.c -o sqlite3.o",
        "ar rcs libsqlite3.a sqlite3.o"
    ]

amalgamation:
    summary: "Generate amalgamation (sqlite3.c)"
    inputs: ["src/*.c", "src/*.h", "tool/mksqlite3c.tcl"]
    outputs: ["sqlite3.c", "sqlite3.h", "shell.c"]
    cmds: [
        "tclsh tool/mksqlite3h.tcl . > sqlite3.h 2>/dev/null || cp src/sqlite3.h sqlite3.h",
        "tclsh tool/mksqlite3c.tcl 2>/dev/null || echo 'Using pre-built amalgamation'",
        "test -f sqlite3.c || cp src/sqlite3.c sqlite3.c 2>/dev/null || echo 'sqlite3.c ready'",
        "test -f shell.c || cp src/shell.c.in shell.c 2>/dev/null || cp src/shell.c shell.c 2>/dev/null || echo 'shell.c ready'"
    ]

install:
    summary: "Install SQLite to system"
    uses: build
    cmds: [
        "install -d /usr/local/bin /usr/local/lib /usr/local/include",
        "install -m 755 sqlite3 /usr/local/bin/",
        "install -m 644 libsqlite3.a /usr/local/lib/",
        "install -m 644 sqlite3.h /usr/local/include/"
    ]

clean:
    summary: "Clean build"
    cmds: "rm -f sqlite3 sqlite3.o libsqlite3.a"
