## Redis Build

set shell = ["sh", "-c"]

build:
    summary: "Build Redis core"
    cmds: "scripts/build.sh redis"

build-all:
    summary: "Build Redis + all modules"
    cmds: "scripts/build.sh all"

test:
    summary: "Run Redis tests"
    uses: build
    cmds: "scripts/test.sh redis"

test-all:
    summary: "Run all tests"
    uses: build-all
    cmds: "scripts/test.sh all"

install:
    summary: "Install Redis"
    uses: build
    cmds: "scripts/deploy.sh redis"

install-all:
    summary: "Install Redis + all modules"
    uses: build-all
    cmds: "scripts/deploy.sh all"

uninstall:
    summary: "Uninstall Redis"
    cmds: "scripts/uninstall.sh redis"

run:
    summary: "Run Redis server"
    uses: build
    cmds: "scripts/run.sh"

bootstrap:
    summary: "Install build prerequisites"
    cmds: "scripts/bootstrap.sh"

modules-update:
    summary: "Clone/update modules (MODULES_UPDATE_SHALLOW=1 for shallow)"
    cmds: "scripts/modules-update.sh"

tarball:
    summary: "Create source tarball (set TAG=<ref>)"
    cmds: "scripts/tarball.sh"

sync-conf:
    summary: "Regenerate redis-full.conf"
    cmds: "scripts/sync-redis-conf.sh"

clean:
    summary: "Clean build artifacts"
    cmds: "scripts/clean.sh redis"

clean-all:
    summary: "Clean Redis + all modules"
    cmds: "scripts/clean.sh all"
