## jq Build - Hardcoded Chasefile for benchmarking
## Builds jq binary and libjq library

set shell = ["sh", "-c"]
set CC = "cc"
set CFLAGS = "-std=gnu99 -O2 -Wall -Wextra -Wno-missing-field-initializers -Wno-unused-parameter -Isrc -I."

build:
    summary: "Build jq"
    uses: jq
    cmds: "echo 'jq build complete'"

jq:
    summary: "Build jq binary"
    uses: libjq
    inputs: ["src/main.c"]
    outputs: ["jq"]
    cmds: "$CC $CFLAGS -o jq src/main.c libjq.a -lm -lpthread"

libjq:
    summary: "Build libjq library"
    uses: parser
    inputs: ["src/compile.c", "src/execute.c", "src/bytecode.c", "src/builtin.c", "src/jv.c", "src/jv_aux.c", "src/jv_parse.c", "src/jv_print.c", "src/jv_unicode.c", "src/jv_alloc.c", "src/jv_dtoa.c", "src/jv_file.c", "src/linker.c", "src/locfile.c", "src/util.c"]
    outputs: ["libjq.a"]
    cmds: [
        "$CC $CFLAGS -c src/compile.c src/execute.c src/bytecode.c src/builtin.c src/jv.c src/jv_aux.c src/jv_parse.c src/jv_print.c src/jv_unicode.c src/jv_alloc.c src/jv_dtoa.c src/jv_file.c src/linker.c src/locfile.c src/util.c src/parser.c src/lexer.c 2>&1 || true",
        "ar rcs libjq.a *.o"
    ]

parser:
    summary: "Generate lexer and parser"
    inputs: ["src/parser.y", "src/lexer.l"]
    outputs: ["src/parser.c", "src/parser.h", "src/lexer.c", "src/lexer.h"]
    cmds: [
        "bison -d -o src/parser.c src/parser.y 2>&1 || echo 'Using pre-generated parser'",
        "flex --header-file=src/lexer.h -o src/lexer.c src/lexer.l 2>&1 || echo 'Using pre-generated lexer'"
    ]

install:
    summary: "Install jq to system"
    uses: build
    cmds: [
        "install -d /usr/local/bin /usr/local/lib /usr/local/include",
        "install -m 755 jq /usr/local/bin/",
        "install -m 644 libjq.a /usr/local/lib/",
        "install -m 644 src/jv.h src/jq.h /usr/local/include/"
    ]

clean:
    summary: "Clean build"
    cmds: "rm -f jq *.o libjq.a"
